---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Digital Dev Tech: apps móviles, sistemas ERP, catálogos con WhatsApp y landing pages de alta conversión. Software a la medida, con alcances claros y tiempos definidos.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08090a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/logo-ddt.svg" />

    <!-- Tipografías: Inter (texto y display) + JetBrains Mono (metadatos) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300..800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Iconografía -->
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      document.documentElement.classList.add('js-anim');
      window.__ddtGuard = window.setTimeout(function () {
        document.documentElement.classList.remove('js-anim');
      }, 4000);
    </script>
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <slot />
  </body>
</html>
