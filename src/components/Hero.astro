---
---

<section class="relative w-full max-w-shell mx-auto px-gutter-mobile lg:px-gutter pt-32 pb-16 lg:pt-40 lg:pb-24">
  <!-- Fondo técnico -->
  <div class="absolute inset-x-0 top-0 h-[520px] grid-bg pointer-events-none -z-10"></div>

  <div class="flex flex-col items-center text-center">
    <!-- Eyebrow -->
    <div
      class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/[0.04] border border-outline-variant mb-8"
      data-reveal
    >
      <span class="relative flex h-1.5 w-1.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary-container opacity-60"></span>
        <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-secondary-container"></span>
      </span>
      <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-on-surface-variant"
        >Software a la medida · Respuesta en menos de 24 horas</span
      >
    </div>

    <!-- Título -->
    <h1
      class="font-display text-display-hero-mobile lg:text-display-hero text-on-surface max-w-4xl tracking-tight"
      data-reveal
    >
      Transforma el Caos Manual en
      <span class="text-gradient-accent animate-gradient">Software Inteligente</span>
    </h1>

    <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl mt-6 leading-relaxed" data-reveal>
      Dejamos de perder tiempo en tareas repetitivas. Diseñamos apps móviles y sistemas a la medida que
      hacen que tu empresa y tu equipo trabajen mejor, con alcances claros y tiempos bien definidos.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center gap-3 mt-9" data-reveal>
      <a
        class="group inline-flex items-center justify-center gap-2 h-10 px-5 rounded-lg bg-[#e5e5e6] text-[#08090a] text-[13px] font-medium hover:bg-white transition-colors duration-150"
        href="#contacto"
      >
        <span>Cotizar mi proyecto</span>
        <span class="material-symbols-outlined text-[16px] group-hover:translate-x-0.5 transition-transform"
          >arrow_forward</span
        >
      </a>
      <a
        class="group inline-flex items-center justify-center gap-2 h-10 px-5 rounded-lg bg-white/[0.06] text-on-surface text-[13px] font-medium border border-outline-variant hover:bg-white/[0.1] hover:border-[#34343a] transition-all duration-150"
        href="#proceso"
      >
        <span class="material-symbols-outlined text-[16px] text-on-surface-variant group-hover:text-on-surface transition-colors"
          >play_circle</span
        >
        <span>Ver cómo trabajamos</span>
      </a>
    </div>

    <!-- Chips de confianza -->
    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 mt-10" data-reveal>
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-[15px] text-secondary-container">verified</span>
        <span class="text-[13px] text-on-surface-variant">Cero papeleo</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-[15px] text-accent">speed</span>
        <span class="text-[13px] text-on-surface-variant">Procesos 10x más rápidos</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-[15px] text-tertiary-container">trending_up</span>
        <span class="text-[13px] text-on-surface-variant">ROI en &lt; 90 días</span>
      </div>
    </div>

    <!-- Marco del producto -->
    <div
      class="w-full max-w-4xl mt-14 rounded-xl bg-surface-container-low/70 backdrop-blur-xl border border-outline-variant overflow-hidden relative"
      data-reveal
    >
      <div
        class="absolute inset-x-0 h-px bg-gradient-to-r from-transparent via-accent/60 to-transparent animate-laser pointer-events-none z-20"
      >
      </div>

      <!-- Barra superior -->
      <div class="flex items-center justify-between gap-3 px-4 py-2.5 border-b border-outline-variant/70">
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-[#3e3e44]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#3e3e44]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#3e3e44]"></span>
          </div>
          <span class="font-mono text-[11px] text-outline hidden sm:inline">DDT_OPERATING_SYSTEM // v1.0</span>
        </div>
        <div class="flex items-center gap-2 overflow-x-auto">
          <span
            class="hidden md:inline-flex items-center gap-1.5 px-2 py-1 rounded-md border border-outline-variant text-[11px] text-on-surface-variant"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-secondary-container"></span>
            Respuesta: <span class="text-on-surface">24h</span>
          </span>
          <span
            class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md border border-outline-variant text-[11px] text-on-surface-variant"
          >
            <span class="material-symbols-outlined text-[13px] text-accent">smart_toy</span>
            Asistente: <span class="text-on-surface">Miga</span>
          </span>
        </div>
      </div>

      <!-- Imagen + anotaciones -->
      <div class="relative w-full overflow-hidden bg-surface-container-lowest">
        <img
          alt="Del trabajo manual caótico al software inteligente automatizado"
          class="w-full h-auto max-h-[520px] object-cover object-center transition-transform duration-700 hover:scale-[1.01]"
          src="/shots/hero-showcase.webp"
          loading="lazy"
        />
        <div class="absolute inset-0 pointer-events-none bg-gradient-to-t from-surface-container-lowest/70 via-transparent to-transparent"></div>

        <div
          class="absolute top-4 left-4 max-w-[230px] p-3 rounded-lg bg-surface-container-lowest/90 backdrop-blur-xl border border-outline-variant text-left animate-float-slow"
        >
          <div class="flex items-center justify-between mb-1">
            <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-accent">Pedidos en vivo</span>
            <span class="font-mono text-[10px] text-outline">QR v4</span>
          </div>
          <p class="text-[12px] text-on-surface-variant leading-snug">
            El cliente pide y paga con QR; tu equipo solo recibe el pedido ya listo.
          </p>
        </div>

        <div
          class="absolute bottom-4 right-4 max-w-[240px] p-3 rounded-lg bg-surface-container-lowest/90 backdrop-blur-xl border border-outline-variant text-left animate-float-delayed"
        >
          <div class="flex items-center justify-between mb-1">
            <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-secondary-container"
              >Panel en vivo</span
            >
            <span class="font-mono text-[10px] text-outline">100% sync</span>
          </div>
          <p class="text-[12px] text-on-surface-variant leading-snug">
            Ventas, inventario y facturación conectados en un solo panel, con la información siempre al día.
          </p>
        </div>
      </div>
    </div>

    <!-- Métricas comparadas -->
    <div class="w-full max-w-4xl mt-4 grid grid-cols-2 md:grid-cols-4 gap-3 text-left" data-reveal>
      <div class="p-4 rounded-lg bg-surface-container-low/60 border border-outline-variant">
        <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-error">Caos manual</span>
        <div class="font-headline-sm text-[20px] text-on-surface font-semibold mt-1">42 hrs/sem</div>
        <span class="text-[12px] text-on-surface-variant">perdidas en tipeo</span>
      </div>
      <div class="p-4 rounded-lg bg-surface-container-low/60 border border-outline-variant">
        <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-error">Margen de error</span>
        <div class="font-headline-sm text-[20px] text-on-surface font-semibold mt-1">18% fallos</div>
        <span class="text-[12px] text-on-surface-variant">en datos desactualizados</span>
      </div>
      <div class="p-4 rounded-lg bg-surface-container-low border border-accent/25">
        <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-accent">Digital Dev Tech</span>
        <div class="font-headline-sm text-[20px] text-on-surface font-semibold mt-1">&lt; 1.2 segundos</div>
        <span class="text-[12px] text-on-surface-variant">respuesta automática</span>
      </div>
      <div class="p-4 rounded-lg bg-surface-container-low border border-secondary-container/25">
        <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-secondary-container">Aceleración</span>
        <div class="font-headline-sm text-[20px] text-on-surface font-semibold mt-1">+340% eficiencia</div>
        <span class="text-[12px] text-on-surface-variant">ROI garantizado &lt; 90 días</span>
      </div>
    </div>
  </div>
</section>
