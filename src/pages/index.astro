---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Process from '../components/Process.astro';
import ProblemSolution from '../components/ProblemSolution.astro';
import Compare from '../components/Compare.astro';
import MigaSpotlight from '../components/MigaSpotlight.astro';
import Services from '../components/Services.astro';
import SoftwareModules from '../components/SoftwareModules.astro';
import Pricing from '../components/Pricing.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import AssistantWidget from '../components/AssistantWidget.astro';
---

<BaseLayout title="Digital Dev Tech | Software Inteligente, Apps y Sistemas ERP">
  <Header />
  <main>
    <Hero />
    <Process />
    <ProblemSolution />
    <Compare />
    <MigaSpotlight />
    <Services />
    <SoftwareModules />
    <Pricing />
    <Contact />
  </main>
  <Footer />
  <AssistantWidget />

  <script is:inline>
    (function () {
      function initSite() {
        // ---------------------------------------------------------
        // 1. Menú móvil
        // ---------------------------------------------------------
        var menuBtn = document.getElementById('mobile-menu-btn');
        var menu = document.getElementById('mobile-menu');
        if (menuBtn && menu) {
          menuBtn.addEventListener('click', function () {
            menu.classList.toggle('hidden');
          });
          menu.querySelectorAll('a').forEach(function (a) {
            a.addEventListener('click', function () {
              menu.classList.add('hidden');
            });
          });
        }

        // ---------------------------------------------------------
        // 2. Formulario de contacto -> WhatsApp
        // ---------------------------------------------------------
        var whatsappBtn = document.getElementById('btn-whatsapp-submit');
        if (whatsappBtn) {
          whatsappBtn.addEventListener('click', function () {
            var nameEl = document.getElementById('client-name');
            var serviceEl = document.getElementById('client-service');
            var notesEl = document.getElementById('client-notes');
            var name = nameEl && nameEl.value.trim() ? nameEl.value.trim() : '';
            var service = serviceEl ? serviceEl.value : '';
            var notes = notesEl && notesEl.value.trim() ? notesEl.value.trim() : '';

            if (!name) {
              alert('Por favor, ingresa tu nombre o el de tu empresa para poder personalizar tu propuesta.');
              if (nameEl) nameEl.focus();
              return;
            }

            var message =
              'Hola, mi nombre es ' +
              name +
              '. Me pongo en contacto desde Digital Dev Tech para cotizar: *' +
              service +
              '*.\n\nDetalles del proyecto:\n' +
              (notes || 'Deseo coordinar una llamada de diagnóstico técnico.');
            window.open('https://wa.me/59171961698?text=' + encodeURIComponent(message), '_blank');
          });
        }

        // ---------------------------------------------------------
        // 3. Calculadora de recuperación (ROI)
        // ---------------------------------------------------------
        var slider = document.getElementById('team-slider');
        var teamDisplay = document.getElementById('team-size-display');
        var hoursDisplay = document.getElementById('hours-saved-display');
        var moneyDisplay = document.getElementById('money-saved-display');

        function formatMoney(value) {
          var rounded = Math.round(value);
          var parts = String(rounded).split('.');
          var integer = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
          return 'Bs ' + integer;
        }

        function updateRoi(value) {
          var people = Math.max(1, Math.min(50, value));
          var hours = people * 8;
          var money = hours * 40;
          if (teamDisplay) {
            teamDisplay.textContent =
              people + (people === 1 ? ' persona' : people >= 50 ? '+ personas' : ' personas');
          }
          if (hoursDisplay) hoursDisplay.textContent = '~' + hours + ' hrs';
          if (moneyDisplay) moneyDisplay.textContent = formatMoney(money);
        }

        if (slider) {
          slider.addEventListener('input', function (e) {
            updateRoi(parseInt(e.target.value, 10));
          });
          updateRoi(parseInt(slider.value, 10));
        }

        // ---------------------------------------------------------
        // 4. Miga: chat flotante + saludo animado
        // ---------------------------------------------------------
        var chat = document.getElementById('miga-chat');
        var toggleBtn = document.getElementById('miga-toggle');
        var closeBtn = document.getElementById('miga-close');
        var messages = document.getElementById('miga-messages');
        var input = document.getElementById('miga-input');
        var form = document.getElementById('miga-form');
        var headerBtn = document.getElementById('header-miga-btn');
        var spotlightBtn = document.getElementById('spotlight-miga-btn');
        var notify = document.getElementById('miga-notify');
        var greeting = document.getElementById('miga-greeting');
        var greetingText = document.getElementById('miga-greeting-text');
        var greetingClose = document.getElementById('miga-greeting-close');

        var GREETING =
          '¡Hola! ¿Cómo estás? Soy Miga, tu asistente en Digital Dev Tech. Listo para dejar los procesos manuales y tediosos: cuéntame y te digo cómo automatizarlos.';

        var respuestas = [
          {
            claves: ['precio', 'cuesta', 'cuanto', 'cuánto', 'valor', 'presupuesto'],
            texto:
              'Trabajamos con alcance y precio definidos por proyecto: sabes qué se va a construir y cuánto vas a pagar antes de empezar. Te armo una estimación en minutos según lo que cuentes en el formulario.',
          },
          {
            claves: ['app', 'movil', 'móvil', 'iphone', 'android'],
            texto:
              'Claro que sí 🐾 Las apps móviles las hacemos con QR, notificaciones y uso sin conexión. Se publican en las tiendas en 4 a 6 semanas. ¿La necesitas para vender, para pedir pedidos o para controlar tu equipo?',
          },
          {
            claves: ['automatizar', 'automatiza', 'proceso', 'manual', 'tedioso'],
            texto:
              'Eso es justo lo que hago yo ⚡ Cargo tus facturas, el stock y los pedidos y los dejo ordenados y automáticos. Cuéntame qué tarea se repite más en tu día y te muestro cómo queda automatizada.',
          },
          {
            claves: ['cotizar', '24', 'contacto', 'hablar', 'asesoria', 'asesoría'],
            texto:
              'Perfecto. Te paso con el equipo: completa el formulario de contacto y te respondemos con un diagnóstico técnico y la cotización en menos de 24 horas.',
          },
          {
            claves: ['erp', 'panel', 'inventario', 'stock', 'gestion', 'gestión'],
            texto:
              'El ERP lo armamos a la medida de tu operación: inventario, ventas, facturación y permisos por rol. Con panel web y datos siempre actualizados 📊',
          },
          {
            claves: ['catalogo', 'catálogo', 'whatsapp', 'qr'],
            texto:
              'Con WhatsApp Business puedes tener catálogo, carrito y pedido con QR. El pedido llega directo al chat de tu equipo sin que nadie teclee nada 🛒',
          },
        ];

        function esc(text) {
          return String(text).replace(/[&<>"]/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
          });
        }

        function appendUser(text) {
          if (!messages) return;
          var wrap = document.createElement('div');
          wrap.className = 'flex items-start justify-end gap-2';
          wrap.innerHTML =
            '<div class="rounded-xl rounded-tr-sm bg-[#e5e5e6] text-[#08090a] p-3 text-[13px] font-medium max-w-[85%]">' +
            esc(text) +
            '</div>';
          messages.appendChild(wrap);
          messages.scrollTop = messages.scrollHeight;
        }

        function appendBot(text) {
          if (!messages) return;
          var wrap = document.createElement('div');
          wrap.className = 'flex items-start gap-2.5';
          wrap.innerHTML =
            '<span class="w-7 h-7 rounded-lg bg-surface-container-lowest border border-outline-variant overflow-hidden shrink-0">' +
            '<img src="/miga-avatar.svg" alt="Miga" class="w-full h-full object-cover"/></span>' +
            '<div class="rounded-xl rounded-tl-sm bg-surface-container-highest/60 border border-outline-variant p-3.5 text-on-surface text-[13px] leading-relaxed">' +
            esc(text) +
            '</div>';
          messages.appendChild(wrap);
          messages.scrollTop = messages.scrollHeight;
        }

        function typingBubble() {
          if (!messages) return null;
          var wrap = document.createElement('div');
          wrap.className = 'flex items-start gap-2.5';
          wrap.innerHTML =
            '<span class="w-7 h-7 rounded-lg bg-surface-container-lowest border border-outline-variant overflow-hidden shrink-0">' +
            '<img src="/miga-avatar.svg" alt="Miga" class="w-full h-full object-cover"/></span>' +
            '<div class="rounded-xl rounded-tl-sm bg-surface-container-highest/60 border border-outline-variant px-4 py-3.5"><span class="inline-flex gap-1">' +
            '<span class="w-1.5 h-1.5 rounded-full bg-accent animate-bounce" style="animation-delay:0s"></span>' +
            '<span class="w-1.5 h-1.5 rounded-full bg-accent animate-bounce" style="animation-delay:.15s"></span>' +
            '<span class="w-1.5 h-1.5 rounded-full bg-accent animate-bounce" style="animation-delay:.3s"></span>' +
            '</span></div>';
          messages.appendChild(wrap);
          messages.scrollTop = messages.scrollHeight;
          return wrap;
        }

        function responder(texto) {
          var lower = texto.toLowerCase();
          var encontrada = null;
          for (var i = 0; i < respuestas.length; i++) {
            var r = respuestas[i];
            for (var j = 0; j < r.claves.length; j++) {
              if (lower.indexOf(r.claves[j]) !== -1) {
                encontrada = r.texto;
                break;
              }
            }
            if (encontrada) break;
          }
          if (!encontrada) {
            encontrada =
              '¡Buena pregunta! 🐾 Lo anoto para el equipo de ingenieros: me cuentalo por WhatsApp al +591 71961698 y te respondemos con el plan técnico el mismo día.';
          }
          var t = typingBubble();
          setTimeout(function () {
            if (t && t.parentNode) t.parentNode.removeChild(t);
            appendBot(encontrada);
          }, 620);
        }

        function abrirChat(mensaje) {
          if (!chat) return;
          chat.classList.remove('hidden');
          if (notify) notify.style.display = 'none';
          if (greeting) greeting.classList.add('hidden');
          if (mensaje) {
            appendUser(mensaje);
            responder(mensaje);
          }
        }

        function cerrarChat() {
          if (chat) chat.classList.add('hidden');
        }

        if (toggleBtn) {
          toggleBtn.addEventListener('click', function () {
            if (chat && chat.classList.contains('hidden')) {
              abrirChat();
            } else {
              cerrarChat();
            }
          });
        }
        if (closeBtn) closeBtn.addEventListener('click', cerrarChat);
        if (headerBtn) {
          headerBtn.addEventListener('click', function () {
            abrirChat();
          });
        }
        if (spotlightBtn) {
          spotlightBtn.addEventListener('click', function () {
            abrirChat('¡Hola Miga! Cuéntame cómo automatizar mi empresa');
          });
        }

        document.querySelectorAll('.miga-chip').forEach(function (chip) {
          chip.addEventListener('click', function () {
            var prompt = chip.getAttribute('data-prompt') || '';
            appendUser(prompt);
            responder(prompt);
          });
        });

        if (form) {
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (!input) return;
            var value = input.value.trim();
            if (!value) return;
            input.value = '';
            appendUser(value);
            responder(value);
          });
        }

        // Saludo automático con efecto de escritura
        if (greeting && greetingText) {
          setTimeout(function () {
            greeting.classList.remove('hidden');
            greeting.classList.add('animate-bubble');
            var i = 0;
            var timer = setInterval(function () {
              greetingText.textContent = GREETING.slice(0, i);
              i += 2;
              if (i >= GREETING.length) {
                clearInterval(timer);
                greetingText.textContent = GREETING;
              }
            }, 22);
            // La burbuja se retira sola para no tapar el contenido
            setTimeout(function () {
              if (greeting && !greeting.classList.contains('hidden')) {
                greeting.classList.add('hidden');
              }
            }, 15000);
          }, 2200);
        }
        if (greetingClose && greeting) {
          greetingClose.addEventListener('click', function () {
            greeting.classList.add('hidden');
          });
        }

        // ---------------------------------------------------------
        // 5. Animaciones de entrada al hacer scroll
        // ---------------------------------------------------------
        var revealEls = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
        revealEls.forEach(function (el) {
          var parent = el.parentElement;
          if (!parent) return;
          var siblings = Array.prototype.slice
            .call(parent.children)
            .filter(function (c) {
              return c.hasAttribute('data-reveal');
            });
          var index = siblings.indexOf(el);
          if (index > 0 && !el.style.getPropertyValue('--ddt-delay')) {
            el.style.setProperty('--ddt-delay', Math.min(index, 6) * 90 + 'ms');
          }
        });

        if (typeof IntersectionObserver === 'function') {
          var observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
          );
          revealEls.forEach(function (el) {
            observer.observe(el);
          });
        } else {
          revealEls.forEach(function (el) {
            el.classList.add('is-visible');
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSite);
      } else {
        initSite();
      }
    })();
  </script>
</BaseLayout>
