---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import img1 from '../assets/fondoMinimarket.jpg';
import service1 from '../assets/ecommerce.png';
import service2 from '../assets/landing-page.png';
import service3 from '../assets/sistema-ventas.png';
import service4 from '../assets/sistema-empresarial.png';
import logo from '../assets/logoDevTech.png';
---

<Layout>
  <div class="relative min-h-screen bg-[#030712] text-slate-100 font-sans selection:bg-emerald-500 selection:text-black overflow-x-hidden">
    
    {/* Fondo con malla moderna y orbes de luz */}
    <div class="fixed inset-0 pointer-events-none z-0">
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl"></div>
      <div class="absolute top-1/2 -right-40 w-96 h-96 bg-sky-500/10 rounded-full blur-3xl"></div>
      <div class="absolute inset-0 bg-[radial-gradient(#1f2937_1px,transparent_1px)] bg-size-[32px_32px] opacity-40"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
{/* Dynamic Floating Header */}
<header x-data="{ mobileMenuOpen: false }" class="sticky top-4 z-50 my-4  bg-slate-900 border border-slate-800/80 rounded-2xl px-4 sm:px-6 py-3 flex items-center justify-between shadow-2xl shadow-emerald-950/20">
  
  {/* Logo */}
  <a href="#inicio" class="shrink-0">
    <Image src={logo} alt="DigitalDevTech" class="h-10 w-48 sm:w-56 object-cover" />
  </a>

  {/* Menú Desktop: Usamos max-lg:hidden para evitar conflictos con la especificidad de 'hidden' */}
  <nav class="max-lg:hidden lg:flex items-center space-x-1 bg-slate-950/50 p-1.5 rounded-xl border border-slate-800">
    <a href="#inicio" class="px-3 xl:px-4 py-1.5 text-xs font-medium text-emerald-400 bg-slate-800/80 rounded-lg shadow-sm whitespace-nowrap">Inicio</a>
    <a href="#nuestra-tecnologia" class="px-3 xl:px-4 py-1.5 text-xs font-medium text-slate-400 hover:text-white transition-all whitespace-nowrap">Nuestra tecnología</a>
    <a href="#servicios" class="px-3 xl:px-4 py-1.5 text-xs font-medium text-slate-400 hover:text-white transition-all whitespace-nowrap">Servicios</a>
    <a href="/camaras" class="px-3 xl:px-4 py-1.5 text-xs font-medium text-slate-400 hover:text-white transition-all whitespace-nowrap">Instalación de cámaras</a>
    <a href="#contactos" class="px-3 xl:px-4 py-1.5 text-xs font-medium text-slate-400 hover:text-white transition-all whitespace-nowrap">Contactos</a>
  </nav>

  {/* CTA Desktop */}
  <div class="max-lg:hidden lg:block">
    <a href="https://wa.me/59171961698?text=Hola,%20me%20gustaría%20solicitar%20una%20cotización" class="bg-linear-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-black font-semibold text-xs py-2.5 px-5 rounded-xl transition-all shadow-lg shadow-emerald-500/20 whitespace-nowrap">
      Solicita una cotización
    </a>
  </div>

  {/* Botón Hamburguesa (Móviles y Tablets < 1024px) */}
  <button 
    @click="mobileMenuOpen = !mobileMenuOpen" 
    type="button" 
    class="lg:hidden p-2 text-slate-300 hover:text-white focus:outline-none bg-slate-800/60 rounded-xl border border-slate-700/50 cursor-pointer"
    aria-label="Abrir menú"
  >
    <svg x-show="!mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
    <svg x-show="mobileMenuOpen" x-cloak class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>

  {/* MENÚ LATERAL DRAWER (Móviles y Tablets < 1024px) */}
  <div 
    x-show="mobileMenuOpen" 
    x-cloak
    class="fixed inset-0 z-50 lg:hidden"
  >
    <div 
      x-show="mobileMenuOpen"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      @click="mobileMenuOpen = false" 
      class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm"
    ></div>

    <div 
      x-show="mobileMenuOpen"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="translate-x-full"
      x-transition:enter-end="translate-x-0"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="translate-x-0"
      x-transition:leave-end="translate-x-full"
      class="fixed inset-y-0 right-0 w-full max-w-xs bg-slate-900 border-l border-slate-800 p-6 flex flex-col justify-between shadow-2xl z-50"
    >
      <div>
        <div class="flex items-center justify-between pb-6 border-b border-slate-800">
          <Image src={logo} alt="DigitalDevTech" class="h-8 w-40 object-cover" />
          <button 
            @click="mobileMenuOpen = false"
            class="p-2 rounded-lg bg-slate-800 text-slate-400 hover:text-white"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <nav class="flex flex-col space-y-3 mt-6">
          <a href="#inicio" @click="mobileMenuOpen = false" class="px-4 py-3 rounded-xl bg-slate-800/80 text-emerald-400 font-medium text-sm flex items-center justify-between border border-emerald-500/20">
            <span>Inicio</span>
            <span class="text-xs">→</span>
          </a>
          <a href="#nuestra-tecnologia" @click="mobileMenuOpen = false" class="px-4 py-3 rounded-xl text-slate-300 hover:bg-slate-800/50 hover:text-white text-sm font-medium transition-colors">
            Nuestra tecnología
          </a>
          <a href="#servicios" @click="mobileMenuOpen = false" class="px-4 py-3 rounded-xl text-slate-300 hover:bg-slate-800/50 hover:text-white text-sm font-medium transition-colors">
            Servicios
          </a>
          <a href="/camaras" @click="mobileMenuOpen = false" class="px-4 py-3 rounded-xl text-slate-300 hover:bg-slate-800/50 hover:text-white text-sm font-medium transition-colors">
            Instalación de cámaras
          </a>
          <a href="#contactos" @click="mobileMenuOpen = false" class="px-4 py-3 rounded-xl text-slate-300 hover:bg-slate-800/50 hover:text-white text-sm font-medium transition-colors">
            Contactos
          </a>
        </nav>
      </div>

      <div class="pt-6 border-t border-slate-800 space-y-4">
        <a href="https://wa.me/59171961698?text=Hola,%20me%20gustaría%20solicitar%20una%20cotización" @click="mobileMenuOpen = false" class="block text-center bg-linear-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-black font-semibold text-xs py-3 px-5 rounded-xl transition-all shadow-lg shadow-emerald-500/20">
          Solicita una cotización
        </a>
        <div class="text-center">
          <p class="text-[11px] text-slate-500">DIGITAL DEV TECH</p>
          <p class="text-[11px] text-emerald-400/80 font-mono">jorgejano97@gmail.com</p>
        </div>
      </div>
    </div>
  </div>
</header>

      {/* HERO SECTION: Asymmetrical Layout */}
      <section id="inicio" class="pt-12 pb-20 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-950/60 border border-emerald-800/50 text-emerald-400 text-xs font-medium">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Tecnología avanzada para tu negocio</span>
          </div>

          <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-white leading-none">
            Tecnología digital <br/>
            <span class="text-transparent bg-clip-text bg-linear-to-r from-emerald-400 via-teal-300 to-sky-400">
              Transformamos tu tiempo
            </span> <br/>
            <span class="text-sky-400">En Oro.</span>
          </h1>

          <p class="text-slate-400 text-base sm:text-lg max-w-xl leading-relaxed">
            <strong class="text-slate-200">DIGITAL DEV TECH:</strong> Tu negocio con soluciones digitales, mayor rendimiento a corto plazo. Ahorras procesos largos y tediosos difíciles de realizar.
          </p>

          <div class="flex flex-wrap gap-3 pt-2">
            <span class="px-4 py-2 bg-slate-900 border border-slate-800 text-xs font-mono text-emerald-400 rounded-lg"># Tiempo</span>
            <span class="px-4 py-2 bg-slate-900 border border-slate-800 text-xs font-mono text-emerald-400 rounded-lg"># Automatización</span>
            <span class="px-4 py-2 bg-slate-900 border border-slate-800 text-xs font-mono text-emerald-400 rounded-lg"># Digitalización</span>
          </div>
        </div>

        {/* Hero Card Accent */}
        <div class="lg:col-span-5 relative">
          <div class="absolute inset-0 bg-linear-to-tr from-emerald-500 to-sky-500 rounded-3xl blur-2xl opacity-20"></div>
          <div class="relative bg-slate-900/90 border border-slate-800 rounded-3xl p-6 backdrop-blur-xl shadow-2xl">
            <div class="flex justify-between items-center pb-4 mb-4 border-b border-slate-800">
              <span class="text-xs font-mono text-slate-400">STATUS_SYSTEM</span>
              <span class="text-xs font-mono text-emerald-400">● OPTIMIZADO</span>
            </div>
            <div class="space-y-4">
              <div class="p-4 bg-slate-950/60 rounded-2xl border border-slate-800/80">
                <p class="text-xs text-slate-400">Rendimiento Estimado</p>
                <p class="text-2xl font-bold text-white mt-1">+100% Eficiencia</p>
              </div>
              <div class="p-4 bg-slate-950/60 rounded-2xl border border-slate-800/80">
                <p class="text-xs text-slate-400">Reducción de Procesos</p>
                <p class="text-2xl font-bold text-emerald-400 mt-1">-80% Tiempo Manual</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* BENTO GRID: Nuestra Tecnología */}
      <section id="nuestra-tecnologia" class="py-16">
        <div class="mb-10">
          <p class="text-xs font-mono text-emerald-400 uppercase tracking-widest">Nuestra Tecnología</p>
          <h2 class="text-3xl font-bold text-white mt-1">TU TIEMPO ES ORO</h2>
          <p class="text-slate-400 text-sm mt-1">Toda la información de nuestro trabajo</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
          <div class="md:col-span-4 bg-slate-900/50 border border-slate-800 rounded-3xl p-6 flex flex-col justify-between hover:border-emerald-500/40 transition-colors">
            <div>
              <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mb-6">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">Ahorro inteligente</h3>
              <p class="text-slate-400 text-xs leading-relaxed">Nuestra soluciones digitales al alcance de todos los negocios ahorra tiempo, liberando recursos valiosos y reduciendo costos operativos fijos para potenciar el crecimiento sostenible de tu negocio o empresa.</p>
            </div>
            <div class="mt-8 pt-4 border-t border-slate-800/80 flex justify-between items-center">
              <span class="text-xs text-slate-400">Taza de éxito</span>
              <span class="text-lg font-bold text-emerald-400">99 %</span>
            </div>
          </div>

          <div class="md:col-span-4 bg-slate-900/50 border border-slate-800 rounded-3xl p-6 flex flex-col justify-between hover:border-emerald-500/40 transition-colors">
            <div>
              <div class="w-12 h-12 rounded-2xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 mb-6">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">Procesos más cortos</h3>
              <p class="text-slate-400 text-xs leading-relaxed">Simplificamos flujos de trabajo diarios para reducir cuellos de botella, transformando tareas complejas en acciones rápidas de ejecutar.</p>
            </div>
            <div class="mt-8 pt-4 border-t border-slate-800/80 flex justify-between items-center">
              <span class="text-xs text-slate-400">Taza de éxito</span>
              <span class="text-lg font-bold text-emerald-400">99 %</span>
            </div>
          </div>

          <div class="md:col-span-4 bg-slate-900/50 border border-slate-800 rounded-3xl p-6 flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-mono text-emerald-400 bg-emerald-950/80 border border-emerald-800/40 px-2 py-0.5 rounded">LA MEJOR EXPERIENCIA DIGITAL</span>
              <h3 class="text-lg font-bold text-white mt-3">Negocios Inteligentes con nuestras soluciones</h3>
              <p class="text-slate-400 text-xs mt-2 leading-relaxed">Todas nuestras soluciones en un solo lugar para expandir tu alcance y atraer más clientes en tiempo récord.</p>
            </div>

            <div class="my-4 overflow-hidden rounded-xl border border-slate-800">
              <Image src={img1} alt="Dashboard de negocio inteligente" class="w-full h-32 object-cover" />
            </div>

            <div class="grid grid-cols-3 gap-2 text-center pt-2 border-t border-slate-800">
              <div>
                <p class="text-xs font-bold text-emerald-400">100%</p>
                <p class="text-[10px] text-slate-500">Eficaz Digital</p>
              </div>
              <div>
                <p class="text-xs font-bold text-emerald-400">100%</p>
                <p class="text-[10px] text-slate-500">Mayor Rendimiento</p>
              </div>
              <div>
                <p class="text-xs font-bold text-emerald-400">100%</p>
                <p class="text-[10px] text-slate-500">Personalizado</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* SERVICIOS: Horizontal Interactive Cards */}
      <section id="servicios" class="py-16">
        <div class="mb-10">
          <p class="text-xs font-mono text-emerald-400 uppercase tracking-widest">Nuestros Servicios</p>
          <h2 class="text-3xl font-bold text-white mt-1">Conoce los servicios que ofrecemos</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          
          {/* Servicio 1 */}
          <div x-data="{ tab: 'linktree' }" class="bg-slate-900/40 border border-slate-800 rounded-2xl p-5 flex flex-col justify-between hover:border-emerald-500/50 hover:bg-slate-900/80 transition-all group">
            <div>
              <div class="overflow-hidden rounded-xl mb-4 border border-slate-800 group-hover:border-slate-700">
                <Image src={service1} alt="Catálogos/Productos" class="w-full h-36 object-cover group-hover:scale-105 transition-transform duration-300" />
              </div>

              <h3 class="font-bold text-white text-base">Catálogos / Productos</h3>
              <p class="text-xs text-slate-400 mt-1">Muestra tus productos de manera rápida y organizada.</p>
              
              <div class="grid grid-cols-2 gap-1 bg-slate-950 p-1 rounded-xl border border-slate-800/80 mt-4">
                <button type="button" @click="tab = 'linktree'" :class="tab === 'linktree' ? 'bg-emerald-500 text-black font-bold shadow-md shadow-emerald-500/20' : 'text-slate-400 hover:text-white font-medium'" class="py-1.5 text-[11px] rounded-lg transition-all duration-200 cursor-pointer">Linktree</button>
                <button type="button" @click="tab = 'tienda'" :class="tab === 'tienda' ? 'bg-emerald-500 text-black font-bold shadow-md shadow-emerald-500/20' : 'text-slate-400 hover:text-white font-medium'" class="py-1.5 text-[11px] rounded-lg transition-all duration-200 cursor-pointer">Tienda Online</button>
              </div>

              <div x-show="tab === 'linktree'" class="mt-4 pt-3 border-t border-slate-800/80">
                <p class="text-[11px] font-semibold text-emerald-400 mb-2">Incluye (Linktree):</p>
                <ul class="text-[11px] text-slate-400 space-y-1.5">
                  <li class="flex items-center"><span class="text-emerald-400 mr-2">✓</span> Link redes sociales.</li>
                  <li class="flex items-center"><span class="text-emerald-400 mr-2">✓</span> Link WhatsApp Business.</li>
                  <li class="flex items-center"><span class="text-emerald-400 mr-2">✓</span> Catálogo de productos.</li>
                  <li class="flex items-center"><span class="text-emerald-400 mr-2">✓</span> Personalización a tu medida.</li>
                </ul>
              </div>

              <div x-show="tab === 'tienda'" x-cloak class="mt-4 pt-3 border-t border-slate-800/80">
                <p class="text-[11px] font-semibold text-emerald-400 mb-2">Incluye (Tienda Online):</p>
                <ul class="text-[11px] text-slate-400 space-y-1.5">
                  <li class="flex items-center"><span class="text-emerald-400 mr-2">✓</span> Página con tus productos.</li>
                  <li class="flex items-center"><span class="text-emerald-400 mr-2">✓</span> QR redireccionado a tu WhatsApp.</li>
                  <li class="flex items-center"><span class="text-emerald-400 mr-2">✓</span> Carrito de Compras.</li>
                  <li class="flex items-center"><span class="text-emerald-400 mr-2">✓</span> De 20 a 30 productos.</li>
                </ul>
              </div>
            </div>

            <button class="mt-6 w-full py-2.5 bg-slate-800 hover:bg-emerald-500 hover:text-black text-slate-200 text-xs font-semibold rounded-xl transition-all cursor-pointer">Más información</button>
          </div>

          {/* Servicio 2 */}
          <div x-data="{ tab: 'landing' }" class="bg-slate-900/40 border border-slate-800 rounded-2xl p-5 flex flex-col justify-between hover:border-emerald-500/50 hover:bg-slate-900/80 transition-all group">
            <div>
              <div class="overflow-hidden rounded-xl mb-4 border border-slate-800 group-hover:border-slate-700">
                <Image src={service2} alt="Landing Page / Página web" class="w-full h-36 object-cover group-hover:scale-105 transition-transform duration-300" />
              </div>

              <h3 class="font-bold text-white text-base">Landing Page / Página web</h3>
              <p class="text-xs text-slate-400 mt-1">Haz que tu negocio sea conocido promociona tus servicios.</p>

              <div class="grid grid-cols-2 gap-1 bg-slate-950 p-1 rounded-xl border border-slate-800/80 mt-4">
                <button type="button" @click.prevent="tab = 'landing'" :class="tab === 'landing' ? 'bg-emerald-500 text-black font-bold shadow-md shadow-emerald-500/20' : 'text-slate-400 hover:text-white font-medium'" class="py-1.5 text-[11px] rounded-lg transition-all duration-200 cursor-pointer">Landing Page</button>
                <button type="button" @click.prevent="tab = 'web'" :class="tab === 'web' ? 'bg-emerald-500 text-black font-bold shadow-md shadow-emerald-500/20' : 'text-slate-400 hover:text-white font-medium'" class="py-1.5 text-[11px] rounded-lg transition-all duration-200 cursor-pointer">Página Web</button>
              </div>

              <div x-show="tab === 'landing'" class="mt-4 pt-3 border-t border-slate-800/80">
                <p class="text-[11px] font-semibold text-emerald-400 mb-2">Incluye (Landing Page):</p>
                <ul class="text-[11px] text-slate-400 space-y-1.5">
                  <li class="flex items-center"><span class="text-emerald-400 mr-2">✓</span> Hosting / dominio.</li>
                  <li class="flex items-center"><span class="text-emerald-400 mr-2">✓</span> Botón llamada a acción.</li>
                  <li class="flex items-center"><span class="text-emerald-400 mr-2">✓</span> Información y ubicación del negocio.</li>
                  <li class="flex items-center"><span class="text-emerald-400 mr-2">✓</span> Soporte técnico 2 meses.</li>
                </ul>
              </div>

              <div x-show="tab === 'web'" x-cloak class="mt-4 pt-3 border-t border-slate-800/80">
                <p class="text-[11px] font-semibold text-emerald-400 mb-2">Incluye (Página Web):</p>
                <ul class="text-[11px] text-slate-400 space-y-1.5">
                  <li class="flex items-center"><span class="text-emerald-400 mr-2">✓</span> Pagina divida por secciones.</li>
                  <li class="flex items-center"><span class="text-emerald-400 mr-2">✓</span> Hosting / dominio.</li>
                  <li class="flex items-center"><span class="text-emerald-400 mr-2">✓</span> Soporte técnico 3 meses.</li>
                  <li class="flex items-center"><span class="text-emerald-400 mr-2">✓</span> Botón redirección a WhatsApp.</li>
                </ul>
              </div>
            </div>

            <button type="button" class="mt-6 w-full py-2.5 bg-slate-800 hover:bg-emerald-500 hover:text-black text-slate-200 text-xs font-semibold rounded-xl transition-all cursor-pointer">Más información</button>
          </div>

          {/* Servicio 3 */}
          <div class="bg-slate-900/40 border border-slate-800 rounded-2xl p-5 flex flex-col justify-between hover:border-emerald-500/50 hover:bg-slate-900/80 transition-all group">
            <div>
              <div class="overflow-hidden rounded-xl mb-4 border border-slate-800 group-hover:border-slate-700">
                <Image src={service3} alt="Sistemas medianos" class="w-full h-36 object-cover group-hover:scale-105 transition-transform duration-300" />
              </div>
              <h3 class="font-bold text-white text-base">Sistemas medianos</h3>
              <p class="text-xs text-slate-400 mt-1">Servicio de software totalmente funcional y completo.</p>
              
              <div class="mt-4 pt-4 border-t border-slate-800/80">
                <p class="text-[11px] font-semibold text-slate-300 mb-2">Incluye:</p>
                <ul class="text-[11px] text-slate-400 space-y-1.5">
                  <li class="flex items-center"><span class="text-emerald-400 mr-2">✓</span> Hosting / dominio.</li>
                  <li class="flex items-center"><span class="text-emerald-400 mr-2">✓</span> Reportes mensuales y semanales</li>
                  <li class="flex items-center"><span class="text-emerald-400 mr-2">✓</span> Metricas estadisticas de tu negocio.</li>
